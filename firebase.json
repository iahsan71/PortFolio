{
  "hosting": {
    "public": "out",
    "site": "ahsan-afzal",
    "trailingSlash": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/blog",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/blog/**",
        "destination": "/",
        "type": 301
      }
    ]
  }
}
